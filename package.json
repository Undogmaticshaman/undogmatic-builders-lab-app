{
  "name": "undogmatic-builders-lab-app",
  "private": true,
  "version": "0.1.0",
  "description": "A calm member workspace for learning, building, and moving forward with Undogmatic Builders Lab.",
  "author": "Undogmatic",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "check": "tsc -b --pretty false",
    "test": "vitest run",
    "preview": "vite preview --host 127.0.0.1",
    "desktop:run": "npm run build && electron .",
    "desktop:dist": "npm run build && electron-builder --win portable"
  },
  "dependencies": {
    "lucide-react": "0.468.0",
    "react": "19.0.0",
    "react-dom": "19.0.0"
  },
  "devDependencies": {
    "@types/react": "19.0.3",
    "@types/react-dom": "19.0.2",
    "@vitejs/plugin-react": "5.1.4",
    "electron": "44.0.0",
    "electron-builder": "26.15.3",
    "typescript": "5.7.2",
    "vite": "7.3.6",
    "vitest": "3.2.6"
  },
  "build": {
    "appId": "com.undogmatic.builderslab",
    "productName": "Undogmatic Builders Lab",
    "artifactName": "Undogmatic-Builders-Lab-${version}-Windows-${arch}.${ext}",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "asar": true,
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ]
    },
    "portable": {
      "artifactName": "Undogmatic-Builders-Lab-${version}-Windows-${arch}.${ext}"
    }
  }
}
