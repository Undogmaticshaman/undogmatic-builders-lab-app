{
  "name": "undogmatic-builders-lab-app",
  "private": true,
  "version": "0.1.0",
  "description": "A calm member workspace for learning, building, and moving forward with Undogmatic Builders Lab.",
  "author": "Undogmatic",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10.0.0"
  },
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "check": "tsc -b --pretty false",
    "test": "vitest run",
    "preview": "vite preview --host 127.0.0.1",
    "desktop:run": "npm run build && electron .",
    "desktop:dist": "npm run desktop:dist:windows",
    "desktop:dist:windows": "npm run build && electron-builder --win portable",
    "desktop:dist:mac": "npm run build && electron-builder --mac dmg zip --x64 --arm64",
    "mobile:doctor": "cap doctor",
    "mobile:add:android": "npm run build && cap add android",
    "mobile:add:ios": "npm run build && cap add ios",
    "mobile:sync": "npm run build && cap sync",
    "mobile:sync:android": "npm run build && cap sync android",
    "mobile:sync:ios": "npm run build && cap sync ios",
    "mobile:open:android": "npm run mobile:sync:android && cap open android",
    "mobile:open:ios": "npm run mobile:sync:ios && cap open ios"
  },
  "dependencies": {
    "@capacitor/android": "7.6.9",
    "@capacitor/core": "7.6.9",
    "@capacitor/ios": "7.6.9",
    "lucide-react": "0.468.0",
    "react": "19.0.0",
    "react-dom": "19.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "7.6.9",
    "@types/react": "19.0.3",
    "@types/react-dom": "19.0.2",
    "@vitejs/plugin-react": "5.1.4",
    "electron": "44.0.0",
    "electron-builder": "26.15.3",
    "typescript": "5.7.2",
    "vite": "7.3.6",
    "vitest": "5.0.0"
  },
  "build": {
    "appId": "com.undogmatic.builderslab",
    "productName": "Undogmatic Builders Lab",
    "artifactName": "Undogmatic-Builders-Lab-${version}-Windows-${arch}.${ext}",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "asar": true,
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "mac": {
      "icon": "build/icon.png",
      "category": "public.app-category.education",
      "artifactName": "Undogmatic-Builders-Lab-${version}-macOS-${arch}.${ext}",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "portable": {
      "artifactName": "Undogmatic-Builders-Lab-${version}-Windows-${arch}.${ext}"
    }
  }
}
